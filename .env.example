# ============================================
# FreshLink Environment Variables
# Copy this file to .env and fill in values.
# The app runs fully in DEMO MODE with zero config.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database
# Leave MONGO_URI empty to auto-launch a local, in-memory MongoDB
# instance (via mongodb-memory-server) — zero setup required.
# Set it to use a real MongoDB instance (local or Atlas) instead.
MONGO_URI=

# Auth
JWT_SECRET=freshlink_dev_secret_change_me
JWT_EXPIRES_IN=7d

# AI / OCR
# Leave AI_API_KEY empty to run in AI_MODE=demo (deterministic mock AI).
# Provide a key to switch the AI service to AI_MODE=api.
AI_API_KEY=
AI_MODE=demo

# Client (Vite)
VITE_API_URL=http://localhost:5000/api
